{
  "name": "cf-vps-monitor",
  "version": "2.0.5",
  "description": "Cloudflare Worker VPS monitor system",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "lint": "wrangler types && tsc --noEmit",
    "test": "node --test",
    "build": "node ../scripts/generate-migrations.mjs && wrangler types && tsc --noEmit",
    "build:frontend": "npm --prefix ../frontend run build",
    "predeploy": "npm run build:frontend && npm run build",
    "deploy": "node ../scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "jose": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "^25.9.3",
    "miniflare": "4.20260722.1",
    "typescript": "^5.0.0",
    "wrangler": "4.156.0"
  }
}
